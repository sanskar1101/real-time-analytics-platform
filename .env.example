# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=analytics_db
POSTGRES_PORT=5432

# Full async DSN consumed by the backend
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/analytics_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-secure-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Real-Time Analytics Platform"
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=4

# ── Reports ───────────────────────────────────────────────────────────────────
# Defaults to <backend_root>/reports inside the container
# REPORTS_DIR=/app/reports

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
UVICORN_WORKERS=2
LOG_LEVEL=info

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
# When running locally: http://localhost:8000
# When running inside Docker network: http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
